{
  "manifest_version": 3,
  "name": "Vexi Browser Pack - Vivaldi",
  "version": "0.1.2",
  "description": "Local structured browser control for Vexi.",
  "permissions": [
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:8767/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}